{
  "name": "@agents-anywhere/opencode-plugin",
  "version": "0.1.0-dev.0",
  "description": "Agents Anywhere loopback bridge hub and OpenCode event projector for OpenCode V2",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./tui": {
      "types": "./lib/tui.d.ts",
      "default": "./lib/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "src",
    "lib",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && tsx scripts/bundle-connector.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.tui.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.tests.json",
    "check:build": "tsx scripts/check-build.ts",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "check": "yarn typecheck && yarn check:build && yarn build && yarn test"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "0.22.14",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "opencode": ">=2.0.6 <3",
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "yarn@4.18.0",
  "license": "MIT"
}
