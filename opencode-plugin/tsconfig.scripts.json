{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    // The build/check scripts import `tsdown`, whose shipped `.d.mts` references
    // optional peer packages (`@volar/typescript`, `publint`, `@tsdown/exe`, …)
    // that are intentionally not installed. Our own script code stays checked;
    // only the third-party declaration bodies are skipped.
    "skipLibCheck": true
  },
  "include": ["tsdown.config.ts", "scripts/**/*.ts"]
}
